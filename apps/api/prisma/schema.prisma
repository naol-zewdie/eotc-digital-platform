// Prisma schema for Ethiopian Orthodox Tewahedo Digital Platform
// Sections 12, 13, 14 of Technical Architecture & Software Development Plan

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ANONYMOUS
  REGISTERED_USER
  CHURCH_REPRESENTATIVE
  EDITOR
  MODERATOR
  ADMINISTRATOR
  SUPER_ADMINISTRATOR
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  REJECTED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum RightsStatus {
  PUBLIC_DOMAIN
  PERMISSION_GRANTED
  CHURCH_OWNED
  RESTRICTED
  UNKNOWN
}

enum ArticleType {
  ARTICLE
  NEWS
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model User {
  id               String             @id @default(uuid())
  email            String             @unique
  displayName      String             @map("display_name")
  passwordHash     String             @map("password_hash")
  role             UserRole           @default(REGISTERED_USER)
  status           String             @default("ACTIVE")
  emailVerifiedAt  DateTime?          @map("email_verified_at")
  lastLoginAt      DateTime?          @map("last_login_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  memberships      ChurchMembership[]
  auditEvents      AuditEvent[]
  filesUploaded    StoredFile[]
  articleRevisions ArticleRevision[]
  articlesAuthored Article[]

  @@map("users")
}

model Church {
  id                 String             @id @default(uuid())
  slug               String             @unique
  region             String?
  city               String?
  coordinates        Json?
  contacts           Json?
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  status             ContentStatus      @default(DRAFT)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  translations       ChurchTranslation[]
  memberships        ChurchMembership[]
  events             Event[]
  media              Media[]
  articles           Article[]

  @@index([slug, status])
  @@map("churches")
}

model ChurchTranslation {
  id          String   @id @default(uuid())
  churchId    String   @map("church_id")
  locale      String   // "am", "gez", "en"
  name        String
  description String?
  history     String?

  church      Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([churchId, locale])
  @@index([locale, name])
  @@map("church_translations")
}

model ChurchMembership {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  churchId   String    @map("church_id")
  role       UserRole  @default(CHURCH_REPRESENTATIVE)
  status     String    @default("ACTIVE")
  verifiedBy String?   @map("verified_by")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  church     Church    @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@unique([userId, churchId])
  @@map("church_memberships")
}

model Category {
  id      String   @id @default(uuid())
  slug    String   @unique
  nameAm  String   @map("name_am")
  nameGez String?  @map("name_gez")
  nameEn  String   @map("name_en")

  books   Book[]
  mezmurs Mezmur[]

  @@map("categories")
}

model RightsRecord {
  id                  String       @id @default(uuid())
  status              RightsStatus @default(UNKNOWN)
  rightsHolder        String?      @map("rights_holder")
  source              String?
  permissionReference String?      @map("permission_reference")
  downloadAllowed     Boolean      @default(true) @map("download_allowed")
  notes               String?
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  books               Book[]
  mezmurs             Mezmur[]
  media               Media[]

  @@map("rights_records")
}

model StoredFile {
  id           String   @id @default(uuid())
  objectKey    String   @unique @map("object_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  bytes        BigInt
  checksum     String?
  status       String   @default("READY")
  uploadedById String?  @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  uploader     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  books        Book[]

  @@map("stored_files")
}

model Book {
  id              String            @id @default(uuid())
  slug            String            @unique
  categoryId      String?           @map("category_id")
  fileId          String?           @map("file_id")
  coverMediaId    String?           @map("cover_media_id")
  publicationYear Int?              @map("publication_year")
  status          ContentStatus     @default(DRAFT)
  rightsId        String?           @map("rights_id")
  sourceId        String?           @map("source_id")
  pageCount       Int?              @map("page_count")
  viewCount       Int               @default(0) @map("view_count")
  downloadCount   Int               @default(0) @map("download_count")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  translations    BookTranslation[]
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  file            StoredFile?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  coverMedia      Media?            @relation("BookCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  rights          RightsRecord?     @relation(fields: [rightsId], references: [id], onDelete: SetNull)
  contentTags     ContentTag[]

  @@index([slug, status])
  @@map("books")
}

model BookTranslation {
  id                String  @id @default(uuid())
  bookId            String  @map("book_id")
  locale            String  // "am", "gez", "en"
  title             String
  description       String?
  authorDisplayName String? @map("author_display_name")

  book              Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, locale])
  @@index([locale, title])
  @@map("book_translations")
}

model Tag {
  id          String       @id @default(uuid())
  name        String       @unique
  contentTags ContentTag[]

  @@map("tags")
}

model ContentTag {
  id        String   @id @default(uuid())
  tagId     String   @map("tag_id")
  bookId    String?  @map("book_id")
  articleId String?  @map("article_id")
  mezmurId  String?  @map("mezmur_id")

  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  mezmur    Mezmur?  @relation(fields: [mezmurId], references: [id], onDelete: Cascade)

  @@map("content_tags")
}

model Artist {
  id      String   @id @default(uuid())
  name    String
  bio     String?
  mezmurs Mezmur[]

  @@map("artists")
}

model Mezmur {
  id               String              @id @default(uuid())
  slug             String              @unique
  artistId         String?             @map("artist_id")
  categoryId       String?             @map("category_id")
  status           ContentStatus       @default(DRAFT)
  rightsId         String?             @map("rights_id")
  externalAudioUrl String?             @map("external_audio_url")
  externalVideoUrl String?             @map("external_video_url")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  translations     MezmurTranslation[]
  artist           Artist?             @relation(fields: [artistId], references: [id], onDelete: SetNull)
  category         Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  rights           RightsRecord?       @relation(fields: [rightsId], references: [id], onDelete: SetNull)
  contentTags      ContentTag[]

  @@index([slug, status])
  @@map("mezmurs")
}

model MezmurTranslation {
  id          String  @id @default(uuid())
  mezmurId    String  @map("mezmur_id")
  locale      String  // "am", "gez", "en"
  title       String
  lyrics      String
  description String?

  mezmur      Mezmur  @relation(fields: [mezmurId], references: [id], onDelete: Cascade)

  @@unique([mezmurId, locale])
  @@index([locale, title])
  @@map("mezmur_translations")
}

model Article {
  id           String               @id @default(uuid())
  slug         String               @unique
  type         ArticleType          @default(ARTICLE)
  authorId     String?              @map("author_id")
  churchId     String?              @map("church_id")
  status       ContentStatus        @default(DRAFT)
  publishedAt  DateTime?            @map("published_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  translations ArticleTranslation[]
  revisions    ArticleRevision[]
  media        Media[]
  contentTags  ContentTag[]
  author       User?                @relation(fields: [authorId], references: [id], onDelete: SetNull)
  church       Church?              @relation(fields: [churchId], references: [id], onDelete: SetNull)

  @@index([slug, status, type])
  @@map("articles")
}

model ArticleTranslation {
  id        String  @id @default(uuid())
  articleId String  @map("article_id")
  locale    String  // "am", "gez", "en"
  title     String
  summary   String?
  body      String

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([locale, title])
  @@map("article_translations")
}

model ArticleRevision {
  id         String   @id @default(uuid())
  articleId  String   @map("article_id")
  revisionNo Int      @map("revision_no")
  editorId   String   @map("editor_id")
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at")

  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  editor     User     @relation(fields: [editorId], references: [id], onDelete: Restrict)

  @@unique([articleId, revisionNo])
  @@map("article_revisions")
}

model Event {
  id          String        @id @default(uuid())
  churchId    String?       @map("church_id")
  slug        String        @unique
  title       String
  description String?
  startAt     DateTime      @map("start_at")
  endAt       DateTime?     @map("end_at")
  timezone    String        @default("Africa/Addis_Ababa")
  venue       String?
  coordinates Json?
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  church      Church?       @relation(fields: [churchId], references: [id], onDelete: SetNull)

  @@index([slug, status, startAt])
  @@map("events")
}

model Media {
  id            String        @id @default(uuid())
  objectKey     String        @unique @map("object_key")
  type          String
  altText       String?       @map("alt_text")
  width         Int?
  height        Int?
  bytes         Int?
  rightsId      String?       @map("rights_id")
  churchId      String?       @map("church_id")
  articleId     String?       @map("article_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  rights        RightsRecord? @relation(fields: [rightsId], references: [id], onDelete: SetNull)
  church        Church?       @relation(fields: [churchId], references: [id], onDelete: SetNull)
  article       Article?      @relation(fields: [articleId], references: [id], onDelete: SetNull)
  coverForBooks Book[]        @relation("BookCoverMedia")

  @@map("media")
}

model Donation {
  id                String        @id @default(uuid())
  provider          String
  providerReference String?       @map("provider_reference")
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("ETB")
  status            PaymentStatus @default(PENDING)
  donorName         String?       @map("donor_name")
  donorEmail        String?       @map("donor_email")
  verifiedAt        DateTime?     @map("verified_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([providerReference, status])
  @@map("donations")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  metadata   Json?
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, action])
  @@map("audit_events")
}
