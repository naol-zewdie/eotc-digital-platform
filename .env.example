# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eotc_db?schema=public"

# Auth and Session secrets
SESSION_SECRET="eotc-super-secret-session-key-min-32-chars-long"
AUTH_SECRET="eotc-super-secret-auth-key-min-32-chars-long"

# S3-Compatible Object Storage
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_BUCKET="eotc-assets"
OBJECT_STORAGE_ACCESS_KEY="minioadmin"
OBJECT_STORAGE_SECRET_KEY="minioadmin"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# Service URLs
PUBLIC_BASE_URL="http://localhost:3000"
API_BASE_URL="http://localhost:4000"
PORT=4000
WEB_PORT=3000

# Mailer
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@eotc-platform.org"

# Observability and Rate limits
ERROR_MONITORING_DSN=""
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
